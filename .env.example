# App identity (not secret)
APP_IDENTIFIER=app.vibehabits.ios
APPLE_TEAM_ID=SB6QYUH97U

# App Store Connect API key
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_CONTENT_BASE64=

# Private repository used by fastlane match
MATCH_GIT_URL=git@github.com:raphaelcangucu/vibe-habits-certificates.git
MATCH_GIT_BRANCH=main
MATCH_PASSWORD=
# Optional locally; CI writes the read-only deploy key to this path
MATCH_GIT_PRIVATE_KEY=

# Required only when running the release lane locally
RELEASE_TAG=v1.0.2
