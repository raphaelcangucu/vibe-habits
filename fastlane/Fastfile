default_platform(:ios)

PROJECT_PATH = "habits tracker.xcodeproj"
SCHEME = "habits tracker"
APP_IDENTIFIER = ENV.fetch("APP_IDENTIFIER", "app.vibehabits.ios")
APPLE_TEAM_ID = ENV.fetch("APPLE_TEAM_ID", "SB6QYUH97U")

def release_version_from_tag
  tag = ENV["GITHUB_REF_NAME"] || ENV["RELEASE_TAG"]
  UI.user_error!("Set RELEASE_TAG (for example, v1.0.2) when running locally") if tag.to_s.empty?

  match = tag.match(/\Av(\d+\.\d+\.\d+)\z/)
  UI.user_error!("Release tags must use the format vMAJOR.MINOR.PATCH") unless match

  match[1]
end

def release_build_number
  if ENV["GITHUB_RUN_NUMBER"]
    "#{ENV.fetch("GITHUB_RUN_NUMBER")}.#{ENV.fetch("GITHUB_RUN_ATTEMPT", "1")}"
  else
    Time.now.utc.strftime("%Y%m%d%H%M")
  end
end

platform :ios do
  desc "Run the unit test suite required by releases"
  lane :test do
    run_tests(
      project: PROJECT_PATH,
      scheme: SCHEME,
      devices: ["iPhone 17"],
      only_testing: ["habits trackerTests"],
      clean: true
    )
  end

  desc "Run the UI test suite separately"
  lane :ui_tests do
    run_tests(
      project: PROJECT_PATH,
      scheme: SCHEME,
      devices: ["iPhone 17"],
      only_testing: ["habits trackerUITests"],
      clean: true
    )
  end

  private_lane :app_store_connect_key do
    ensure_env_vars(
      env_vars: %w[
        APP_STORE_CONNECT_KEY_ID
        APP_STORE_CONNECT_ISSUER_ID
        APP_STORE_CONNECT_KEY_CONTENT_BASE64
      ]
    )

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT_BASE64"),
      is_key_content_base64: true
    )
  end

  private_lane :sync_app_store_signing do |options|
    ensure_env_vars(env_vars: %w[MATCH_GIT_URL MATCH_PASSWORD])
    readonly_signing = is_ci || ENV["SKIP_UPLOAD"] == "true"
    setup_ci if is_ci

    match_options = {
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      team_id: APPLE_TEAM_ID,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: ENV.fetch("MATCH_GIT_BRANCH", "main"),
      api_key: options.fetch(:api_key),
      readonly: readonly_signing
    }
    match_options[:git_private_key] = ENV["MATCH_GIT_PRIVATE_KEY"] unless ENV["MATCH_GIT_PRIVATE_KEY"].to_s.empty?

    sync_code_signing(**match_options)
  end

  desc "Create the initial App Store certificate and provisioning profile"
  lane :bootstrap_signing do
    sync_app_store_signing(api_key: app_store_connect_key)
  end

  desc "Upload the reviewed App Store listing and screenshots without a binary"
  lane :store_listing do
    upload_to_app_store(
      api_key: app_store_connect_key,
      app_version: ENV.fetch("APP_STORE_VERSION", "1.0.6"),
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      skip_binary_upload: true,
      skip_metadata: ENV["SKIP_STORE_METADATA"] == "true",
      skip_app_version_update: false,
      overwrite_screenshots: false,
      sync_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Test, archive, sign, and upload a tagged build to App Store Connect/TestFlight"
  lane :release do
    version = release_version_from_tag
    build_number = release_build_number
    api_key = app_store_connect_key

    test
    sync_app_store_signing(api_key: api_key)

    build_app(
      project: PROJECT_PATH,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "VibeHabits-#{version}-#{build_number}.ipa",
      xcargs: [
        "MARKETING_VERSION=#{version}",
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='match AppStore #{APP_IDENTIFIER}'"
      ].join(" "),
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}"
        }
      }
    )

    if ENV["SKIP_UPLOAD"] == "true"
      UI.success("Vibe Habits #{version} (#{build_number}) passed local release validation; upload was skipped")
    else
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true
      )

      UI.success("Vibe Habits #{version} (#{build_number}) was uploaded to App Store Connect")
    end
  end
end
